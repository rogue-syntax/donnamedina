/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// The version comes from source/version.h, the plugin's one version number (host, About screen,
// update check, release package). The names are the store's, with the TM sign (U+2122), written
// as escapes in L"" strings so this file stays ASCII (code_page 1252).
#include "source/version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MAJOR_VERSION_INT,SUB_VERSION_INT,RELEASE_NUMBER_INT,BUILD_NUMBER_INT
 PRODUCTVERSION MAJOR_VERSION_INT,SUB_VERSION_INT,RELEASE_NUMBER_INT,BUILD_NUMBER_INT
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004e4"
        BEGIN
            VALUE "CompanyName", L"Rogue Syntax Sound Design\x2122 LLC"
            VALUE "FileDescription", L"Donna Medina\x2122"
            VALUE "FileVersion", FULL_VERSION_STR
            VALUE "InternalName", "RSSynth001donnaMedina"
            VALUE "LegalCopyright", L"\x00A9 Rogue Syntax Sound Design\x2122 LLC"
            VALUE "OriginalFilename", "RSSynth001donnaMedina.vst3"
            VALUE "ProductName", L"Donna Medina\x2122"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 1252
    END
END


